# ID numérico de tu propiedad GA4 (Admin → Property settings)
# Ejemplo: 123456789
GA4_PROPERTY_ID=

# Opción A (recomendada): pegar el JSON completo del service account en una línea
# o como string multilínea entre comillas.
GA4_SERVICE_ACCOUNT_JSON=

# Opción B: campos sueltos del JSON del service account
# GOOGLE_CLIENT_EMAIL=nombre@proyecto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Opción C: ruta al archivo JSON descargado
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/ga4-service-account.json

# Firebase Auth (cliente web) — valores de Project settings → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Embudos (opcional). Override del embudo de conversión.
# Por defecto: Home → Contacto → Thank-you en adereso.ai.
# El embudo de interés (Home → Pricing + siguientes páginas) está fijo en código.
# GA4_FUNNEL_STEPS=[{"name":"Home","hostNames":["adereso.ai","www.adereso.ai"],"pagePath":"/"},{"name":"Contacto","hostNames":["adereso.ai","www.adereso.ai"],"pagePath":"/contacto"},{"name":"Thank-you","hostNames":["adereso.ai","www.adereso.ai"],"pagePath":"/thank-you-page"}]
